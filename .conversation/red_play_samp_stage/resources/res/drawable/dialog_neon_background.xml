<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1aff3333"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0d0d1a"
                android:endColor="#0a0a14"
                android:angle="135"
                android:type="linear"
                android:centerColor="#12121f"/>
            <corners android:radius="18dp"/>
            <stroke
                android:width="1.5dp"
                android:color="#ff3333"/>
        </shape>
    </item>
</layer-list>
