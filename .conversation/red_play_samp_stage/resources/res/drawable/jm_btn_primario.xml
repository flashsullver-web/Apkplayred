<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ff9a35d4"
                android:endColor="#ff3398cf"
                android:angle="0"
                android:type="linear"
                android:centerColor="#ff8636d4"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ffbd43ff"
                android:endColor="#ff3fbbfe"
                android:angle="0"
                android:type="linear"
                android:centerColor="#ffa541ff"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
</selector>
