<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#330c0915"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#cc0c0915"
                android:endColor="#000c0915"
                android:angle="0"
                android:type="linear"
                android:centerX="0.4"
                android:centerColor="#4d0c0915"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#f00c0915"
                android:endColor="#000c0915"
                android:angle="180"
                android:type="linear"
                android:centerX="0.52"
                android:centerColor="#000c0915"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#b30c0915"
                android:endColor="#000c0915"
                android:angle="0"
                android:type="radial"
                android:centerX="1"
                android:centerY="0"
                android:gradientRadius="70%"
                android:centerColor="#590c0915"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#990c0915"
                android:endColor="#000c0915"
                android:angle="90"
                android:type="linear"
                android:centerY="0.3"
                android:centerColor="#000c0915"/>
        </shape>
    </item>
</layer-list>
