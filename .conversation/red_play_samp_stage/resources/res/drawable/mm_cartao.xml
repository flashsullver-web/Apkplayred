<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#94141220"/>
            <corners android:radius="@dimen/_8sdp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#52bd43ff"
                android:endColor="#003fbbfe"
                android:angle="0"
                android:type="radial"
                android:centerX="0.78"
                android:centerY="0.12"
                android:gradientRadius="60%p"
                android:centerColor="#183fbbfe"/>
            <corners android:radius="@dimen/_8sdp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="@dimen/_8sdp"/>
            <stroke
                android:width="1dp"
                android:color="#1fffffff"/>
        </shape>
    </item>
</layer-list>
