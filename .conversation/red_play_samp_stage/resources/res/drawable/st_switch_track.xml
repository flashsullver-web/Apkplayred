<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ffbd43ff"
                android:endColor="#ff3fbbfe"
                android:angle="0"
                android:type="linear"
                android:centerColor="#ffa541ff"/>
            <corners android:radius="999dp"/>
            <size
                android:height="22dp"
                android:width="38dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33ffffff"/>
            <corners android:radius="999dp"/>
            <stroke
                android:width="1dp"
                android:color="#24ffffff"/>
            <size
                android:height="22dp"
                android:width="38dp"/>
        </shape>
    </item>
</selector>
