<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mm_root"
    android:background="#ff0c0915"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/mm_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:background="@drawable/mm_veu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:id="@+id/mm_coluna"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/_130sdp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_22sdp"
        android:layout_marginStart="@dimen/_30sdp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_36sdp"
            android:src="@drawable/hud_logo_unity"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp">
            <View
                android:background="@drawable/mm_linha_esq"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/_5sdp"
                android:textColor="#c7ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_titulo"
                android:includeFontPadding="false"
                android:fontFamily="@font/sfprodisplaysemibold"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_3sdp"
                android:letterSpacing="0.5"/>
            <View
                android:background="@drawable/mm_linha_dir"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mm_itens"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_11sdp">
            <LinearLayout
                android:id="@+id/mm_item_continuar"
                style="@style/MmItem">
                <ImageView
                    android:id="@+id/mm_item_continuar_ic"
                    android:src="@drawable/mm_ic_continuar"
                    style="@style/MmItemIcone"/>
                <TextView
                    android:id="@+id/mm_item_continuar_tx"
                    android:text="@string/mm_continuar"
                    style="@style/MmItemTexto"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mm_item_mapa"
                style="@style/MmItem">
                <ImageView
                    android:id="@+id/mm_item_mapa_ic"
                    android:src="@drawable/mm_ic_mapa"
                    style="@style/MmItemIcone"/>
                <TextView
                    android:id="@+id/mm_item_mapa_tx"
                    android:text="@string/mm_mapa"
                    style="@style/MmItemTexto"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mm_item_config"
                style="@style/MmItem">
                <ImageView
                    android:id="@+id/mm_item_config_ic"
                    android:src="@drawable/mm_ic_config"
                    style="@style/MmItemIcone"/>
                <TextView
                    android:id="@+id/mm_item_config_tx"
                    android:text="@string/mm_config"
                    style="@style/MmItemTexto"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mm_item_sair"
                style="@style/MmItem">
                <ImageView
                    android:id="@+id/mm_item_sair_ic"
                    android:src="@drawable/mm_ic_sair"
                    style="@style/MmItemIcone"/>
                <TextView
                    android:id="@+id/mm_item_sair_tx"
                    android:text="@string/mm_sair"
                    style="@style/MmItemTexto"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/mm_cartao_area"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/_160sdp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_22sdp"
        android:layout_marginEnd="@dimen/_52sdp">
        <FrameLayout
            android:id="@+id/mm_cartao"
            android:background="@drawable/mm_cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_28sdp">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="@dimen/_10sdp"
                android:paddingBottom="@dimen/_9sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/_60sdp">
                    <TextView
                        android:textSize="@dimen/_17sdp"
                        android:textColor="#ffffffff"
                        android:ellipsize="end"
                        android:id="@+id/mm_nome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        android:shadowColor="#80000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:lineSpacingMultiplier="0.92"
                        android:fontFamily="@font/din_pro_black_italic"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp">
                        <TextView
                            android:textColor="#ffe3b8ff"
                            android:id="@+id/mm_id"
                            android:background="@drawable/mm_pilula_roxa"
                            style="@style/MmPilula"/>
                        <TextView
                            android:textColor="#ffb6e6ff"
                            android:id="@+id/mm_score"
                            android:background="@drawable/mm_pilula_azul"
                            android:layout_marginStart="@dimen/_3sdp"
                            style="@style/MmPilula"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp">
                        <View
                            android:id="@+id/mm_status_ponto"
                            android:background="@drawable/mm_ponto_status"
                            android:layout_width="@dimen/_4sdp"
                            android:layout_height="@dimen/_4sdp"/>
                        <TextView
                            android:textSize="@dimen/_6sdp"
                            android:textColor="#ffffffff"
                            android:ellipsize="end"
                            android:id="@+id/mm_servidor_nome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/sfprodisplaysemibold"
                            android:layout_marginStart="@dimen/_4sdp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/_5sdp"
                        android:textColor="#80ffffff"
                        android:ellipsize="end"
                        android:id="@+id/mm_servidor_ip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/sfprodisplaymedium"
                        android:layout_marginStart="@dimen/_8sdp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp">
                    <LinearLayout style="@style/MmNumero">
                        <LinearLayout style="@style/MmNumeroTopo">
                            <com.sampunity.launcher.ui.SinalView
                                android:id="@+id/mm_sinal"
                                android:layout_width="@dimen/_8sdp"
                                android:layout_height="@dimen/_5sdp"
                                android:layout_marginEnd="@dimen/_3sdp"/>
                            <TextView
                                android:text="@string/mm_ping"
                                style="@style/MmNumeroRotulo"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/mm_ping"
                            style="@style/MmNumeroValor"/>
                    </LinearLayout>
                    <LinearLayout style="@style/MmNumero">
                        <LinearLayout style="@style/MmNumeroTopo">
                            <ImageView
                                android:src="@drawable/mm_ic_pessoa"
                                style="@style/MmNumeroIcone"/>
                            <TextView
                                android:text="@string/mm_online"
                                style="@style/MmNumeroRotulo"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/mm_online"
                            style="@style/MmNumeroValor"/>
                    </LinearLayout>
                    <LinearLayout style="@style/MmNumero">
                        <LinearLayout style="@style/MmNumeroTopo">
                            <ImageView
                                android:src="@drawable/ic_cmd_relogio"
                                style="@style/MmNumeroIcone"/>
                            <TextView
                                android:text="@string/mm_sessao"
                                style="@style/MmNumeroRotulo"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/mm_sessao_tempo"
                            style="@style/MmNumeroValor"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/mm_link_comunidade"
                    android:background="@drawable/mm_discord_btn"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:paddingStart="@dimen/_7sdp"
                    android:paddingEnd="@dimen/_6sdp">
                    <ImageView
                        android:layout_width="@dimen/_10sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:src="@drawable/mm_ic_discord"
                        app:tint="#ff8c96ff"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_6sdp">
                        <TextView
                            android:textSize="@dimen/_6sdp"
                            android:textColor="#ffffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mm_comunidade_discord"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/sfprodisplaybold"/>
                        <TextView
                            android:textSize="@dimen/_4sdp"
                            android:textColor="#99ffffff"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:text="@string/mm_comunidade_desc_curta"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/sfprodisplaymedium"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:src="@drawable/mm_ic_seta"
                        app:tint="#8cffffff"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/mm_avatar"
            android:layout_width="@dimen/_92sdp"
            android:layout_height="@dimen/_92sdp"
            android:scaleType="fitCenter"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/mm_barra"
        android:background="@drawable/mm_barra"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_22sdp"
        android:paddingStart="@dimen/_15sdp"
        android:paddingEnd="@dimen/_15sdp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/mm_link_site"
                android:paddingStart="0dp"
                style="@style/MmRede">
                <ImageView
                    android:src="@drawable/mm_ic_globo"
                    app:tint="#d1ffffff"
                    style="@style/MmRedeIcone"/>
                <TextView
                    android:text="@string/mm_site"
                    style="@style/MmRedeTexto"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mm_social_discord"
                android:background="@drawable/mm_link_sep"
                style="@style/MmRede">
                <ImageView
                    android:src="@drawable/mm_ic_discord"
                    app:tint="#d1ffffff"
                    style="@style/MmRedeIcone"/>
                <TextView
                    android:text="@string/mm_discord"
                    style="@style/MmRedeTexto"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mm_social_instagram"
                android:background="@drawable/mm_link_sep"
                style="@style/MmRede">
                <ImageView
                    android:src="@drawable/mm_ic_instagram"
                    app:tint="#d1ffffff"
                    style="@style/MmRedeIcone"/>
                <TextView
                    android:text="@string/mm_instagram"
                    style="@style/MmRedeTexto"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mm_social_whatsapp"
                android:background="@drawable/mm_link_sep"
                style="@style/MmRede">
                <ImageView
                    android:src="@drawable/mm_ic_whatsapp"
                    app:tint="#d1ffffff"
                    style="@style/MmRedeIcone"/>
                <TextView
                    android:text="@string/mm_whatsapp"
                    style="@style/MmRedeTexto"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:background="@drawable/mm_ponto_pausa"
                android:layout_width="@dimen/_3sdp"
                android:layout_height="@dimen/_3sdp"/>
            <TextView
                android:textSize="@dimen/_5sdp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_pausado"
                android:includeFontPadding="false"
                android:fontFamily="@font/sfprodisplaysemibold"
                android:layout_marginStart="@dimen/_4sdp"
                android:letterSpacing="0.14"/>
            <TextView
                android:textSize="@dimen/_5sdp"
                android:textColor="#ffffffff"
                android:id="@+id/mm_afk_text"
                android:background="@drawable/jm_chip"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/sfprodisplaysemibold"
                android:paddingStart="@dimen/_4sdp"
                android:paddingEnd="@dimen/_4sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:letterSpacing="0.04"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
