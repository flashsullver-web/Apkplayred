<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
    android:layout_gravity="bottom"
    android:id="@+id/main_interface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/surface_main_interface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1"/>
    <FrameLayout
        android:id="@+id/interface_ui_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/dialog_server"/>
        <include layout="@layout/tab"/>
        <include layout="@layout/editobject"/>
        <include layout="@layout/hud"/>
        <FrameLayout
            android:id="@+id/mm_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</FrameLayout>
