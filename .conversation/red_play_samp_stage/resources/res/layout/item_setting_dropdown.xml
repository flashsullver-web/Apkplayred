<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_setting_item"
    android:padding="@dimen/_14sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/white"
            android:id="@+id/setting_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titulo"
            android:fontFamily="@font/muller_medium"/>
        <TextView
            android:textSize="@dimen/_10ssp"
            android:textColor="#888888"
            android:id="@+id/setting_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="Descricao da opcao"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/setting_dropdown_container"
        android:background="@drawable/bg_dropdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp">
        <TextView
            android:textSize="@dimen/_11ssp"
            android:textColor="@color/white"
            android:id="@+id/setting_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opcao"/>
        <ImageView
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:src="@drawable/ic_arrow_down"
            android:tint="#888888"
            android:layout_marginStart="@dimen/_6sdp"/>
    </LinearLayout>
</LinearLayout>
