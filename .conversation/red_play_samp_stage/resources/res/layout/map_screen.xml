<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mp_root"
    android:background="#ff0c0915"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sampunity.game.core.ui.map.FullMapView
        android:id="@+id/mp_mapa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/mp_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_38sdp"
        android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/mp_pilula"
            android:background="@drawable/mp_pilula"
            android:paddingTop="@dimen/_3sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_3sdp"
            android:paddingEnd="@dimen/_13sdp"
            android:elevation="4dp">
            <ImageView
                android:id="@+id/mp_back_btn"
                android:background="@drawable/mp_voltar_miolo"
                android:padding="@dimen/_6sdp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:src="@drawable/nv_back"
                app:tint="#ffffffff"/>
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="#ffffffff"
                android:id="@+id/mp_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_mapa"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textAllCaps="true"
                android:fontFamily="@font/din_pro_black_italic"
                android:layout_marginStart="@dimen/_7sdp"
                android:letterSpacing="0.02"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:textSize="@dimen/_7sdp"
            android:textColor="#d9ffffff"
            android:gravity="center"
            android:id="@+id/mp_dica"
            android:background="@drawable/jm_btn_vidro"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_20sdp"
            android:text="@string/mp_dica"
            android:includeFontPadding="false"
            android:fontFamily="@font/sfprodisplaymedium"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="start|bottom"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginStart="@dimen/_14sdp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/mp_centralizar"
            android:background="@drawable/jm_btn_vidro"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:paddingStart="@dimen/_9sdp"
            android:paddingEnd="@dimen/_11sdp">
            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/nv_target"
                android:layout_marginEnd="@dimen/_5sdp"/>
            <com.sampunity.game.core.ui.util.CapCenterTextView
                android:textSize="@dimen/_7sdp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mp_centralizar"
                android:includeFontPadding="false"
                android:fontFamily="@font/sfprodisplaysemibold"
                android:letterSpacing="0.06"/>
        </LinearLayout>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:textSize="@dimen/_7sdp"
            android:textColor="#ffff7a7a"
            android:gravity="center"
            android:id="@+id/mp_remover"
            android:background="@drawable/jm_btn_vidro"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:text="@string/mp_remover"
            android:includeFontPadding="false"
            android:fontFamily="@font/sfprodisplaysemibold"
            android:paddingStart="@dimen/_11sdp"
            android:paddingEnd="@dimen/_11sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:letterSpacing="0.06"/>
    </LinearLayout>
</FrameLayout>
