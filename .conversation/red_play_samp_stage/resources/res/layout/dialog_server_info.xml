<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/nv_folha"
    android:paddingTop="10dp"
    android:paddingBottom="22dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/nv_alca"
        android:layout_width="38dp"
        android:layout_height="5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <FrameLayout
            android:id="@+id/serverTile"
            android:background="@drawable/nv_tile_aberto"
            android:layout_width="54dp"
            android:layout_height="54dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/serverTileIcon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/nv_play"
                app:tint="#ffecb0ff"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp">
            <TextView
                android:textSize="19sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/serverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="@font/sfprodisplaybold"
                android:letterSpacing="-0.015"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#9a93a8"
                android:ellipsize="end"
                android:id="@+id/serverIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:fontFamily="@font/sfprodisplaymedium"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/btnFavStar"
            android:background="@drawable/nv_circulo_vidro"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/nv_star"
            app:tint="#ffffffff"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/nv_grade_celula"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="13dp"
            android:paddingVertical="12dp">
            <TextView
                android:textSize="11sp"
                android:textColor="#9a93a8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nv_rotulo_jogadores"
                android:fontFamily="@font/sfprodisplaysemibold"
                android:letterSpacing="0.04"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/white"
                android:id="@+id/serverPlayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:fontFamily="@font/sfprodisplaybold"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/nv_grade_celula"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.85"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="12dp">
            <TextView
                android:textSize="11sp"
                android:textColor="#9a93a8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nv_rotulo_ping"
                android:fontFamily="@font/sfprodisplaysemibold"
                android:letterSpacing="0.04"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/white"
                android:id="@+id/serverPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:fontFamily="@font/sfprodisplaybold"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/nv_grade_celula"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.45"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="12dp">
            <TextView
                android:textSize="11sp"
                android:textColor="#9a93a8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nv_rotulo_idioma"
                android:fontFamily="@font/sfprodisplaysemibold"
                android:letterSpacing="0.04"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <ImageView
                    android:id="@+id/serverFlag"
                    android:layout_width="17dp"
                    android:layout_height="12dp"
                    android:src="@drawable/bandeira_br"
                    android:layout_marginEnd="7dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/serverLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@font/sfprodisplaybold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#b3a6c2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/nv_seu_nick"
        android:fontFamily="@font/sfprodisplaysemibold"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/nv_campo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="14dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/nv_user"
            android:layout_marginEnd="10dp"
            app:tint="#ffb3a6c2"/>
        <EditText
            android:textSize="15sp"
            android:textColor="@color/white"
            android:textColorHint="#66ffffff"
            android:id="@+id/inputPlayerName"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/nv_exemplo_nick"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:fontFamily="@font/sfprodisplaymedium"
            android:importantForAutofill="no"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/btnConnect"
        android:background="@drawable/nv_botao_branco"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/nv_play"
            android:layout_marginEnd="8dp"
            app:tint="#ffbd43ff"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff8e2de2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_button"
            android:fontFamily="@font/sfprodisplaybold"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/btnFavorite"
        android:background="@drawable/nv_botao_fantasma"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/btnFavoriteIcon"
            android:visibility="gone"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/nv_trash"
            android:layout_marginEnd="8dp"
            app:tint="#ffff6961"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:id="@+id/btnFavoriteText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nv_voltar"
            android:fontFamily="@font/sfprodisplaysemibold"/>
    </LinearLayout>
</LinearLayout>
