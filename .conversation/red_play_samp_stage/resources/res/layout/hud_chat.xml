<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hud_chat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:rotationY="0">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/hud_chat_start_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/hud_chat_end_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.68"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/hud_chat_input_end_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.8"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/hud_chat_botao_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.68"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hud_chat_container"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/hud_chat_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/hud_chat_start_guideline"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hud_chat_fade_box"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.94"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.sampunity.game.core.ui.hud.chat.ChatRecyclerView
                android:scrollbarSize="@dimen/_10sdp"
                android:scrollbarThumbVertical="@drawable/chat_scroll_front"
                android:scrollbarTrackVertical="@drawable/chat_scroll_back"
                android:scrollbarStyle="insideInset"
                android:id="@+id/hud_chat_view"
                android:scrollbars="vertical"
                android:fadingEdgeLength="24dp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scrollbarFadeDuration="1000"
                android:fadeScrollbars="true"
                android:requiresFadingEdge="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:stackFromEnd="true"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hud_chat_side"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="0.25"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="@+id/hud_chat_botao_guideline"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/hud_button_chat_hide"
            android:background="@drawable/bg_chat_toggle"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_16sdp"
            android:paddingStart="@dimen/_5sdp"
            android:paddingEnd="@dimen/_4sdp">
            <ImageView
                android:layout_width="@dimen/_9sdp"
                android:layout_height="@dimen/_9sdp"
                android:src="@drawable/ic_chat_bolha"/>
            <ImageView
                android:id="@+id/hud_button_chat_hide_seta"
                android:layout_width="@dimen/_9sdp"
                android:layout_height="@dimen/_9sdp"
                android:src="@drawable/ic_chat_seta"
                android:layout_marginStart="@dimen/_2sdp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/hud_keyboard_input_body"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_2sdp"
        app:layout_constraintEnd_toEndOf="@+id/hud_chat_input_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/hud_chat_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/hud_chat_container">
        <FrameLayout
            android:id="@+id/hud_keyboard_field"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.sampunity.game.core.ui.util.CustomEditText
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/white"
                android:textColorHint="#80ffffff"
                android:id="@+id/hud_keyboard_input"
                android:background="@drawable/bg_chat_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/chat_caixa_dica"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_28sdp"/>
            <View
                android:layout_gravity="start|center_vertical"
                android:id="@+id/hud_keyboard_cursor"
                android:background="#ffbd43ff"
                android:visibility="invisible"
                android:layout_width="2dp"
                android:layout_height="@dimen/_13sdp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/hud_keyboard_button_recentes"
                android:background="@drawable/bg_cmd_relogio"
                android:padding="@dimen/_4sdp"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:src="@drawable/ic_cmd_relogio"
                android:layout_marginEnd="@dimen/_4sdp"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hud_keyboard_button_slash"
            android:background="@drawable/bg_chat_input"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_4sdp">
            <TextView
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/white"
                android:id="@+id/hud_keyboard_button_slash_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hud_keyboard_button_next"
            android:background="@drawable/bg_chat_input"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_4sdp">
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/white"
                android:id="@+id/hud_keyboard_button_next_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="︿"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hud_keyboard_button_prev"
            android:background="@drawable/bg_chat_input"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_4sdp">
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/white"
                android:id="@+id/hud_keyboard_button_prev_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="﹀"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/hud_texto_menu"
        android:background="@drawable/bg_texto_menu"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_24sdp"
        android:layout_marginBottom="@dimen/_3sdp"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/hud_keyboard_input_body"
        app:layout_constraintStart_toStartOf="@+id/hud_keyboard_input_body"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/hud_cmd_painel"
        android:background="@drawable/bg_cmd_painel"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_2sdp"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/hud_keyboard_input_body"
        app:layout_constraintEnd_toEndOf="@+id/hud_keyboard_input_body">
        <TextView
            android:textSize="@dimen/_6sdp"
            android:textColor="#8cffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_2sdp"
            android:text="@string/cmd_recentes_titulo"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:fontFamily="@font/sfprodisplaybold"
            android:layout_marginStart="@dimen/_9sdp"
            android:letterSpacing="0.06"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hud_cmd_lista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
