<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:background="#ff2a0a38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_inicio"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/veu_topo"
        android:background="@drawable/nv_veu_topo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.38"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/veu_baixo"
        android:background="@drawable/nv_veu_baixo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.fragment.app.FragmentContainerView
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:id="@+id/nav_host_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_graph"/>
    <View
        android:id="@+id/veu_nav"
        android:background="@drawable/nv_veu_nav"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="130dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/nav_bg"
        android:background="@drawable/nv_nav_capsula"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/btn_home"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="62dp"
        android:layout_height="42dp"
        android:src="@drawable/nv_home"
        android:paddingVertical="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/nav_bg"
        app:layout_constraintEnd_toStartOf="@+id/btn_servers"
        app:layout_constraintStart_toStartOf="@+id/nav_bg"
        app:layout_constraintTop_toTopOf="@+id/nav_bg"
        app:tint="#ffffffff"/>
    <ImageView
        android:id="@+id/btn_servers"
        android:background="@drawable/nv_circulo_branco"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="8dp"
        android:foreground="@drawable/circle_ripple"
        android:src="@drawable/ic_nav_servers"
        android:contentDescription="@string/servers_title"
        android:elevation="10dp"
        android:outlineSpotShadowColor="#ff461082"
        android:outlineAmbientShadowColor="#ff461082"
        app:layout_constraintBottom_toBottomOf="@+id/nav_bg"
        app:layout_constraintEnd_toEndOf="@+id/nav_bg"
        app:layout_constraintStart_toStartOf="@+id/nav_bg"/>
    <ImageView
        android:id="@+id/btn_settings"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="62dp"
        android:layout_height="42dp"
        android:src="@drawable/nv_gear"
        android:contentDescription="@string/settings_title"
        android:paddingVertical="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/nav_bg"
        app:layout_constraintEnd_toEndOf="@+id/nav_bg"
        app:layout_constraintStart_toEndOf="@+id/btn_servers"
        app:layout_constraintTop_toTopOf="@+id/nav_bg"
        app:tint="#9effffff"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_info_main"
        android:background="#e60a0b0f"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dialogConstraintLayout"
            android:background="@drawable/background_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_11sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/_16sdp"
                    android:textColor="@color/white"
                    android:id="@+id/dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_title"
                    android:fontFamily="@font/muller_medium"/>
                <ImageView
                    android:id="@+id/update_icon"
                    android:background="@drawable/update_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/_8sdp"
                    android:textColor="@color/white"
                    android:id="@+id/dialog_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_description"
                    android:alpha="0.8"
                    android:fontFamily="@font/muller_regular"/>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_10sdp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dialog_back"
                    android:background="@drawable/background_dialog_button"
                    android:padding="@dimen/_5sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_6sdp"
                        android:textColor="@color/white"
                        android:id="@+id/dialog_title_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/close_button"
                        android:fontFamily="@font/muller_regular"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
