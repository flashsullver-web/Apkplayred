<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/st_root"
    android:background="#ff0c0915"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/st_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_config"
        android:scaleType="centerCrop"/>
    <View
        android:background="@drawable/jm_veu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/st_header"
        android:background="@drawable/jm_barra"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_38sdp"
        android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/st_back_btn"
            android:background="@drawable/nv_circulo_vidro"
            android:padding="@dimen/_6sdp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/nv_back"
            app:tint="#ffffffff"/>
        <TextView
            android:textSize="@dimen/_15sdp"
            android:textColor="#ffffffff"
            android:id="@+id/st_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/st_title"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:fontFamily="@font/din_pro_black_italic"
            android:layout_marginStart="@dimen/_10sdp"
            android:letterSpacing="0.02"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:textSize="@dimen/_7sdp"
            android:textColor="#d9ffffff"
            android:gravity="center"
            android:id="@+id/st_restore_btn"
            android:background="@drawable/jm_btn_fantasma"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_20sdp"
            android:text="@string/st_restore"
            android:includeFontPadding="false"
            android:fontFamily="@font/sfprodisplaysemibold"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/st_tabs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginStart="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/st_header"
        app:layout_constraintWidth_percent="0.21">
        <TextView
            android:textSize="@dimen/_6sdp"
            android:textColor="#66ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_5sdp"
            android:text="@string/st_sections"
            android:textAllCaps="true"
            android:fontFamily="@font/sfprodisplaymedium"
            android:layout_marginStart="@dimen/_8sdp"
            android:letterSpacing="0.1"/>
        <LinearLayout
            android:id="@+id/st_tab_graphics"
            style="@style/JmAba">
            <ImageView
                android:src="@drawable/ic_st_monitor"
                style="@style/JmAbaIcone"/>
            <TextView
                android:text="@string/st_tab_graphics"
                style="@style/JmAbaTexto"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/st_tab_sound"
            style="@style/JmAba">
            <ImageView
                android:src="@drawable/ic_st_sound"
                style="@style/JmAbaIcone"/>
            <TextView
                android:text="@string/st_tab_sound"
                style="@style/JmAbaTexto"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/st_tab_controls"
            style="@style/JmAba">
            <ImageView
                android:src="@drawable/ic_st_gamepad"
                style="@style/JmAbaIcone"/>
            <TextView
                android:text="@string/st_tab_controls"
                style="@style/JmAbaTexto"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/st_tab_game"
            style="@style/JmAba">
            <ImageView
                android:src="@drawable/ic_st_gear"
                style="@style/JmAbaIcone"/>
            <TextView
                android:text="@string/st_tab_game"
                style="@style/JmAbaTexto"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/st_card"
        android:background="@drawable/jm_vidro"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/st_tabs"
        app:layout_constraintTop_toBottomOf="@+id/st_header">
        <ScrollView
            android:id="@+id/st_scroll"
            android:scrollbars="none"
            android:fadingEdgeLength="@dimen/_10sdp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/st_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
