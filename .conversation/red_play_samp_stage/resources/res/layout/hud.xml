<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hud_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/logo_image"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginBottom="@dimen/_18sdp"
        android:src="@drawable/hud_logo_unity"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:alpha="0.95"
        android:layout_marginStart="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/hud_radar_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="@dimen/_94sdp"
        android:layout_height="@dimen/_94sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:alpha="0"
        android:layout_marginStart="@dimen/_8sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.sampunity.game.core.ui.hud.radar.RadarView
            android:id="@+id/hud_radar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.sampunity.game.core.ui.hud.controls.GameControlsOverlay
        android:id="@+id/hud_game_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include layout="@layout/hud_button_interactions"/>
    <include
        android:id="@+id/hud_chat_main"
        layout="@layout/hud_chat"/>
    <include layout="@layout/hud_chatkill"/>
</androidx.constraintlayout.widget.ConstraintLayout>
