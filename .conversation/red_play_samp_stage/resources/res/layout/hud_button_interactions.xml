            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_1sdp">
            <ImageView
                android:id="@+id/hud_h_button_interactions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/hud_btn_bg_hz"/>
            <TextView
                android:text="H"
                style="@style/HudActionButtonText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hud_y_button_interactions_container"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_1sdp">
            <ImageView
                android:id="@+id/hud_y_button_interactions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/hud_btn_bg_hz"/>
            <TextView
                android:text="Y"
                style="@style/HudActionButtonText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hud_n_button_interactions_container"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_1sdp">
