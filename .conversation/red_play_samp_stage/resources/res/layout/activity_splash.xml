<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_splash"
    android:background="#ff2a0a38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detect_gpu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/background_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_abertura"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/nv_veu_topo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/nv_degrade_rodape"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.22"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/logo_area"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="260dp"
        android:layout_height="160dp"
        android:layout_marginTop="118dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.sampunity.launcher.ui.OrbitaView
            android:tag="tras"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/logo_splash"
            android:layout_width="106dp"
            android:layout_height="140dp"
            android:src="@drawable/logo_simbolo"
            android:scaleType="fitCenter"/>
        <com.sampunity.launcher.ui.OrbitaView
            android:tag="frente"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/splash_pe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="12.5sp"
            android:textColor="#dbffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nv_verificando"
            android:shadowColor="#d9140424"
            android:shadowRadius="8"
            android:fontFamily="@font/sfprodisplaymedium"
            android:letterSpacing="0.02"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#99ffffff"
            android:id="@+id/splash_versao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:shadowColor="#cc140424"
            android:shadowRadius="6"
            android:fontFamily="@font/sfprodisplaymedium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
