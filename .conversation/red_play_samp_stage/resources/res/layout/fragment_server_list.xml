<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/emptyState"
        android:background="@drawable/nv_vidro_cartao"
        android:paddingTop="26dp"
        android:paddingBottom="22dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:paddingHorizontal="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:background="@drawable/nv_vazio_circulo"
            android:layout_width="64dp"
            android:layout_height="64dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/nv_star"
                app:tint="#ffffe48a"/>
        </FrameLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/emptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nv_favoritos_vazio_titulo"
            android:fontFamily="@font/sfprodisplaybold"
            android:letterSpacing="-0.01"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ffb3a6c2"
            android:gravity="center"
            android:id="@+id/emptyTextHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="260dp"
            android:text="@string/nv_favoritos_vazio_texto"
            android:lineSpacingMultiplier="1.15"
            android:fontFamily="@font/sfprodisplaymedium"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btnVazioAdicionar"
            android:background="@drawable/nv_botao_branco"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/nv_plus"
                android:layout_marginEnd="8dp"
                app:tint="#ffbd43ff"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ff8e2de2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nv_adicionar_por_ip"
                android:fontFamily="@font/sfprodisplaybold"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/serverList"
        android:paddingTop="6dp"
        android:paddingBottom="140dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#ffbd43ff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
