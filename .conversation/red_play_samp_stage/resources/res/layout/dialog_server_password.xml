<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_container"
    android:layout_width="@dimen/_280sdp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#a71a0f0f"
    app:cardCornerRadius="@dimen/_15sdp"
    app:cardElevation="0dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_15sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/lock_icon"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:src="@drawable/ic_lock"
            app:tint="#ff6b6b"/>
        <TextView
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:textColor="#ff6b6b"
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_6sdp"
            android:text="SERVIDOR TRANCADO"
            android:fontFamily="@font/muller_medium"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/_10ssp"
            android:textColor="@color/white"
            android:id="@+id/dialog_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:text="Este servidor está trancado.\10\10Se você faz parte da equipe de desenvolvimento, digite sua senha de acesso:"
            android:alpha="0.85"
            android:fontFamily="@font/muller_regular"
            android:textAlignment="center"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_12sdp"
            app:cardBackgroundColor="#2a1f1f"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_10sdp">
                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:src="@drawable/ic_lock"
                    app:tint="#666666"/>
                <EditText
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/white"
                    android:textColorHint="#666666"
                    android:id="@+id/password_input"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_38sdp"
                    android:hint="Digite a senha..."
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:fontFamily="@font/muller_regular"
                    android:layout_marginStart="@dimen/_8sdp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/exit_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/_38sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_6sdp"
                app:cardBackgroundColor="#2a1f1f"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:src="@drawable/menu_close"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:tint="#ff6b6b"/>
                    <TextView
                        android:textSize="@dimen/_11ssp"
                        android:textColor="#a2a2a2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAIR"
                        android:fontFamily="@font/muller_medium"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/connect_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/_38sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_6sdp"
                app:cardBackgroundColor="#ff6b6b"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/_11ssp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONECTAR"
                        android:fontFamily="@font/muller_medium"
                        android:layout_marginEnd="@dimen/_5sdp"/>
                    <ImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:src="@drawable/arrow_back"
                        android:rotation="0"
                        app:tint="@color/white"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
