<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_container"
    android:layout_width="@dimen/_300sdp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#e8201510"
    app:cardCornerRadius="@dimen/_15sdp"
    app:cardElevation="0dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_18sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/maintenance_icon"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:src="@drawable/ic_maintenance"
            app:tint="#ff6b6b"/>
        <TextView
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:textColor="#ff6b6b"
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:text="SERVIDOR TRANCADO"
            android:fontFamily="@font/muller_medium"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/_11ssp"
            android:textColor="@color/white"
            android:id="@+id/dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_15sdp"
            android:text="Este servidor está trancado.\10\10O acesso está restrito no momento.\10\10Tente novamente mais tarde."
            android:lineSpacingExtra="@dimen/_3sdp"
            android:alpha="0.9"
            android:fontFamily="@font/muller_regular"
            android:textAlignment="center"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_15sdp"
            app:cardBackgroundColor="#2a1f1f"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/_14ssp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="��"/>
                <TextView
                    android:textSize="@dimen/_10ssp"
                    android:textColor="#aaaaaa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Siga nossas redes sociais para novidades!"
                    android:layout_weight="1"
                    android:fontFamily="@font/muller_regular"
                    android:layout_marginStart="@dimen/_8sdp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/ok_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="#ff6b6b"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="0dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OK"
                    android:fontFamily="@font/muller_medium"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.cardview.widget.CardView>
