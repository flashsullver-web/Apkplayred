<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/nv_folha"
    android:paddingTop="10dp"
    android:paddingBottom="22dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/nv_alca"
        android:layout_width="38dp"
        android:layout_height="5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <FrameLayout
            android:background="@drawable/nv_tile_aberto"
            android:layout_width="54dp"
            android:layout_height="54dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/nv_server"
                app:tint="#ffecb0ff"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp">
            <TextView
                android:textSize="19sp"
                android:textColor="@color/white"
                android:id="@+id/dialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nv_add_titulo"
                android:fontFamily="@font/sfprodisplaybold"
                android:letterSpacing="-0.015"/>
            <TextView
                android:textSize="12.5sp"
                android:textColor="#ffb3a6c2"
                android:id="@+id/dialogDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/nv_add_texto"
                android:lineSpacingMultiplier="1.1"
                android:fontFamily="@font/sfprodisplaymedium"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffb3a6c2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/nv_add_rotulo"
        android:fontFamily="@font/sfprodisplaysemibold"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/nv_campo_foco"
        android:addStatesFromChildren="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="15dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/nv_server"
            android:layout_marginEnd="11dp"
            app:tint="#ffecb0ff"/>
        <EditText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:textColorHint="#59ffffff"
            android:id="@+id/inputIp"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="127.0.0.1:7777"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textUri"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:fontFamily="@font/sfprodisplaymedium"
            android:importantForAutofill="no"/>
    </LinearLayout>
    <TextView
        android:textSize="11.5sp"
        android:textColor="#ff9a93a8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/nv_add_dica"
        android:fontFamily="@font/sfprodisplaymedium"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btnCancel"
            android:background="@drawable/nv_botao_fantasma"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/nv_cancelar"
            android:layout_weight="1"
            android:fontFamily="@font/sfprodisplaysemibold"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btnAdd"
            android:background="@drawable/nv_botao_branco"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:layout_marginStart="10dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/nv_plus"
                android:layout_marginEnd="8dp"
                app:tint="#ffbd43ff"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ff8e2de2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nv_adicionar"
                android:fontFamily="@font/sfprodisplaybold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
