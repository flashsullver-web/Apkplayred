<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/logo_main"
        android:layout_width="wrap_content"
        android:layout_height="92dp"
        android:layout_marginTop="44dp"
        android:src="@drawable/logo_simbolo"
        android:adjustViewBounds="true"
        android:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/app_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_main">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/nv_globo"
            android:layout_marginEnd="6dp"
            app:tint="#bdffffff"/>
        <TextView
            android:textSize="12.5sp"
            android:textColor="#bdffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_text"
            android:shadowColor="#99140424"
            android:shadowRadius="6"
            android:fontFamily="@font/sfprodisplaymedium"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="#ffffffff"
        android:id="@+id/social_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/communities_label"
        android:shadowColor="#d9140424"
        android:shadowRadius="8"
        android:textAllCaps="true"
        android:fontFamily="@font/sfprodisplaymedium"
        android:letterSpacing="0.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_subtitle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/social_media_section"
        android:background="@drawable/nv_grupo_redes"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/social_label">
        <ImageView
            android:id="@+id/discord_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:layout_width="56dp"
            android:layout_height="46dp"
            android:src="@drawable/rede_discord"/>
        <View
            android:background="#26ffffff"
            android:layout_width="1dp"
            android:layout_height="20dp"/>
        <ImageView
            android:id="@+id/instagram_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:layout_width="56dp"
            android:layout_height="46dp"
            android:src="@drawable/rede_instagram"/>
        <View
            android:background="#26ffffff"
            android:layout_width="1dp"
            android:layout_height="20dp"/>
        <ImageView
            android:id="@+id/whatsapp_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:layout_width="56dp"
            android:layout_height="46dp"
            android:src="@drawable/rede_whatsapp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cartao_parceiro"
        android:background="@drawable/nv_vidro_cartao"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/nv_chama"
                android:layout_marginEnd="5dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nv_servidor_parceiro"
                android:fontFamily="@font/sfprodisplaysemibold"/>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:id="@+id/parceiro_nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:fontFamily="@font/sfprodisplaybold"
            android:letterSpacing="-0.02"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView
                android:textSize="12sp"
                android:textColor="#a79fb5"
                android:id="@+id/parceiro_jogadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/sfprodisplaymedium"/>
            <View
                android:background="@drawable/nv_ponto_divisor"
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="8dp"/>
            <com.sampunity.launcher.ui.SinalView
                android:id="@+id/parceiro_sinal"
                android:layout_width="16dp"
                android:layout_height="10dp"
                android:layout_marginEnd="5dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#a79fb5"
                android:id="@+id/parceiro_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/sfprodisplaymedium"/>
            <View
                android:id="@+id/parceiro_div_pais"
                android:background="@drawable/nv_ponto_divisor"
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="8dp"/>
            <ImageView
                android:id="@+id/parceiro_bandeira"
                android:layout_width="17dp"
                android:layout_height="12dp"
                android:src="@drawable/bandeira_br"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:id="@+id/parceiro_pais"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/sfprodisplaybold"/>
        </LinearLayout>
        <View
            android:background="#1fffffff"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <View
                android:background="@drawable/nv_ponto_verde"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="10.5sp"
                android:textColor="#9a93a8"
                android:ellipsize="end"
                android:id="@+id/parceiro_ip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="@font/sfprodisplaysemibold"
                android:letterSpacing="0.01"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/parceiro_jogar"
                android:background="@drawable/nv_botao_branco"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:elevation="3dp"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/nv_play"
                    android:layout_marginEnd="6dp"
                    app:tint="#ffbd43ff"/>
                <TextView
                    android:textSize="13.5sp"
                    android:textColor="#ff8e2de2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nv_jogar"
                    android:fontFamily="@font/sfprodisplaybold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
