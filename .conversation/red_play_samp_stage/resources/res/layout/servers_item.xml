<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/server_main"
    android:background="@drawable/nv_vidro_cartao"
    android:paddingTop="13dp"
    android:paddingBottom="14dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="18dp"
    android:layout_marginVertical="5dp"
    android:paddingHorizontal="15dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/server_tile"
            android:background="@drawable/nv_tile_aberto"
            android:layout_width="46dp"
            android:layout_height="46dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/server_play_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/nv_play"
                app:tint="#ffecb0ff"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="13dp">
            <TextView
                android:textSize="14.5sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/textServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/sfprodisplaysemibold"
                android:letterSpacing="-0.01"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <ImageView
                    android:id="@+id/server_flag"
                    android:layout_width="17dp"
                    android:layout_height="12dp"
                    android:src="@drawable/nv_globo"
                    android:layout_marginEnd="7dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#b3a6c2"
                    android:ellipsize="end"
                    android:id="@+id/textAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:fontFamily="@font/sfprodisplaymedium"
                    android:letterSpacing="0.01"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/players_container"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_jogadores"
            android:background="@drawable/nv_chip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="10dp">
            <ImageView
                android:id="@+id/icon_players"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/nv_user"
                android:layout_marginEnd="6dp"
                app:tint="#ffb3a6c2"/>
            <TextView
                android:textSize="11.5sp"
                android:textColor="#ffb3a6c2"
                android:id="@+id/textPlayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/sfprodisplaymedium"/>
            <ProgressBar
                android:id="@+id/barPlayers"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:max="1000"
                android:progressDrawable="@drawable/nv_barra_progresso"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="2dp"
                style="?android:attr/progressBarStyleHorizontal"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_ping"
            android:background="@drawable/nv_chip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="10dp">
            <com.sampunity.launcher.ui.SinalView
                android:id="@+id/server_sinal"
                android:layout_width="16dp"
                android:layout_height="10dp"
                android:layout_marginEnd="5dp"/>
            <TextView
                android:textSize="11.5sp"
                android:textColor="#ffb3a6c2"
                android:id="@+id/textPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/sfprodisplaymedium"/>
        </LinearLayout>
        <TextView
            android:textSize="11.5sp"
            android:textColor="#ffff8a8a"
            android:gravity="center"
            android:id="@+id/chip_fechado"
            android:background="@drawable/nv_chip_fechado"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/nv_fechado"
            android:fontFamily="@font/sfprodisplaysemibold"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>
</LinearLayout>
