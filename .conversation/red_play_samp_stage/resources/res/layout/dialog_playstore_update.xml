<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_container"
    android:layout_width="@dimen/_280sdp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#e61a1a1a"
    app:cardCornerRadius="@dimen/_15sdp"
    app:cardElevation="0dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_15sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/update_icon"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:src="@drawable/ic_update_neon"
            app:tint="#e0e0e0"/>
        <TextView
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_6sdp"
            android:text="NOVA VERSÃO DISPONÍVEL"
            android:fontFamily="@font/muller_medium"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/_10ssp"
            android:textColor="@color/white"
            android:id="@+id/dialog_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_12sdp"
            android:text="Uma nova versão do app está disponível na Play Store. Atualize para continuar jogando."
            android:alpha="0.75"
            android:fontFamily="@font/muller_regular"
            android:textAlignment="center"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cancel_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/_38sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_6sdp"
                app:cardBackgroundColor="#2d2d2d"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/_11ssp"
                        android:textColor="#808080"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAIR"
                        android:fontFamily="@font/muller_medium"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/update_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/_38sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_6sdp"
                app:cardBackgroundColor="#e0e0e0"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:src="@drawable/ic_update_neon"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:tint="#1a1a1a"/>
                    <TextView
                        android:textSize="@dimen/_11ssp"
                        android:textColor="#1a1a1a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ATUALIZAR"
                        android:fontFamily="@font/muller_medium"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
