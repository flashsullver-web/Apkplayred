<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/tab_background"
        android:layout_width="@dimen/_400sdp"
        android:layout_height="@dimen/_250sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/menu_list_cmd1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center"
                    android:id="@+id/constraintLayout16"
                    android:layout_width="@dimen/_130sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <EditText
                        android:textSize="@dimen/_8sdp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/progress_gray"
                        android:id="@+id/searchInput"
                        android:background="@drawable/players_list_border_search"
                        android:paddingBottom="@dimen/_2sdp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:hint="@string/players_list_search_hint"
                        android:singleLine="true"
                        android:inputType="text"
                        android:imeOptions="flagNoFullscreen|actionSearch"
                        android:fontFamily="@font/din_pro_medium"
                        android:paddingStart="@dimen/_9sdp"
                        android:autofillHints="no"
                        android:importantForAutofill="no"/>
                    <ImageView
                        android:id="@+id/clearSearchButton"
                        android:visibility="invisible"
                        android:clickable="true"
                        android:layout_width="@dimen/_10sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:layout_alignTop="@+id/searchInput"
                        android:layout_alignBottom="@+id/searchInput"
                        android:layout_marginEnd="@dimen/_13sdp"
                        android:layout_alignEnd="@+id/searchInput"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/cross"/>
                    <ImageView
                        android:id="@+id/goSearchButton"
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:src="@drawable/ic_search"
                        android:layout_alignTop="@+id/searchInput"
                        android:layout_alignBottom="@+id/searchInput"
                        android:layout_marginEnd="8dp"
                        android:layout_alignEnd="@+id/searchInput"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/white"
                    android:id="@+id/playerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:fontFamily="@font/din_pro_medium"
                    android:layout_marginEnd="@dimen/_40sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Button
                    android:layout_gravity="center"
                    android:id="@+id/closeButton"
                    android:background="@drawable/cross"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    app:backgroundTint="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/recycle_name_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/menu_list_cmd1"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            app:layout_constraintTop_toBottomOf="@+id/menu_list_cmd1">
            <TextView
                android:textSize="@dimen/_7sdp"
                android:textColor="#959494"
                android:gravity="center_vertical"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="wrap_content"
                android:text="@string/players_list_header_first_column"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:paddingStart="@dimen/_5sdp"
                android:font="@font/din_pro_black"/>
            <TextView
                android:textSize="@dimen/_7sdp"
                android:textColor="#959494"
                android:gravity="center_vertical"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="wrap_content"
                android:text="NickName"
                android:includeFontPadding="false"
                android:layout_weight="5"
                android:font="@font/din_pro_black"/>
            <TextView
                android:textSize="@dimen/_7sdp"
                android:textColor="#959494"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="wrap_content"
                android:text="Score"
                android:includeFontPadding="false"
                android:layout_weight="3"
                android:paddingStart="@dimen/_10sdp"
                android:font="@font/din_pro_black"/>
            <TextView
                android:textSize="@dimen/_7sdp"
                android:textColor="#959494"
                android:layout_width="@dimen/_5sdp"
                android:layout_height="match_parent"
                android:text="Ping"
                android:includeFontPadding="false"
                android:layout_weight="2"
                android:layout_marginStart="@dimen/_20sdp"
                android:font="@font/din_pro_black"/>
        </LinearLayout>
        <View
            android:id="@+id/view"
            android:background="@drawable/button_red_rectangle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/recycle_name_column"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recycle_name_column"/>
        <com.factor.bouncy.BouncyRecyclerView
            android:scrollbarThumbVertical="0x7f080314"
            android:scrollbarTrackVertical="0x7f080315"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarStyle="insideInset"
            android:id="@+id/recycle"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="8dp"
            android:layout_below="@+id/recycle_name_column"
            android:fadeScrollbars="false"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view"
            app:recyclerview_damping_ratio="DAMPING_RATIO_MEDIUM_BOUNCY"
            app:recyclerview_fling_animation_size="0.1"
            app:recyclerview_overscroll_animation_size="0.1"
            app:recyclerview_stiffness="STIFFNESS_LOW"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
