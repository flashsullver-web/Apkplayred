<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="32sp"
        android:textColor="@color/white"
        android:id="@+id/title_servers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/servers_title"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:shadowColor="#80140424"
        android:shadowRadius="10"
        android:textAllCaps="true"
        android:fontFamily="@font/din_pro_black_italic"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        android:letterSpacing="0.02"
        app:layout_constraintEnd_toStartOf="@+id/fab_add_server"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/fab_add_server"
        android:background="@drawable/nv_circulo_vidro"
        android:padding="10dp"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/nv_plus"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_servers"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_servers"
        app:tint="#ffffffff"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/moldura_abas"
        android:background="@drawable/nv_segmento_fundo"
        android:padding="4dp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_servers">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/nv_aba_texto"
            android:gravity="center"
            android:id="@+id/aba_oficiais"
            android:background="@drawable/nv_segmento_item"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/tab_official"
            android:layout_weight="1"
            android:fontFamily="@font/sfprodisplaysemibold"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/nv_aba_texto"
            android:gravity="center"
            android:id="@+id/aba_favoritos"
            android:background="@drawable/nv_segmento_item"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/tab_favorites"
            android:layout_weight="1"
            android:fontFamily="@font/sfprodisplaysemibold"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moldura_abas"/>
</androidx.constraintlayout.widget.ConstraintLayout>
