<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/he_root"
    android:background="#59000000"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/he_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/he_bar"
        android:background="@drawable/jm_vidro"
        android:paddingTop="@dimen/_5sdp"
        android:paddingBottom="@dimen/_5sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:paddingStart="@dimen/_6sdp"
        android:paddingEnd="@dimen/_6sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:id="@+id/he_tab_foot"
            android:text="@string/he_tab_foot"
            style="@style/JmEditorChip"/>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:id="@+id/he_tab_car"
            android:text="@string/he_tab_car"
            style="@style/JmEditorChip"/>
        <View style="@style/JmEditorSep"/>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:id="@+id/he_size_dec"
            android:minWidth="@dimen/_22sdp"
            android:text="−"
            style="@style/JmEditorChip"/>
        <TextView
            android:id="@+id/he_size_label"
            android:text="@string/he_size"
            style="@style/JmEditorRotulo"/>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:id="@+id/he_size_inc"
            android:minWidth="@dimen/_22sdp"
            android:text="+"
            style="@style/JmEditorChip"/>
        <View
            android:id="@+id/he_alpha_sep"
            style="@style/JmEditorSep"/>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:id="@+id/he_alpha_dec"
            android:minWidth="@dimen/_22sdp"
            android:text="−"
            style="@style/JmEditorChip"/>
        <TextView
            android:id="@+id/he_alpha_label"
            android:text="@string/he_alpha"
            style="@style/JmEditorRotulo"/>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:id="@+id/he_alpha_inc"
            android:minWidth="@dimen/_22sdp"
            android:text="+"
            style="@style/JmEditorChip"/>
        <View style="@style/JmEditorSep"/>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:id="@+id/he_reset"
            android:text="@string/he_reset"
            style="@style/JmEditorChip"/>
        <com.sampunity.game.core.ui.util.CapCenterTextView
            android:id="@+id/he_done"
            android:background="@drawable/jm_btn_primario"
            android:text="@string/he_done"
            style="@style/JmEditorChip"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/_7sdp"
        android:textColor="#d9ffffff"
        android:id="@+id/he_hint"
        android:background="@drawable/jm_chip"
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="@string/he_hint"
        android:fontFamily="@font/sfprodisplaymedium"
        android:paddingStart="@dimen/_9sdp"
        android:paddingEnd="@dimen/_9sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/he_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
